# ============================================================================
# POS CLIENT DEMO MODE CONFIGURATION
# Completely isolated standalone mock mode with local SQLite database
# Zero production data leakage - no live databases or external payment gateways
# ============================================================================

DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# Staff domain & local session signing secret
STAFF_AUTH_EMAIL_DOMAIN=posdemo.com
SESSION_COOKIE_SECRET=demo-pos-client-session-key-32-chars-minimum

# Production Supabase credentials are intentionally deactivated in Demo Mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
