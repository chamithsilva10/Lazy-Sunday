# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-side Secrets (Keep private, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Session Cookie Signing Secret (Must be 32+ characters)
SESSION_COOKIE_SECRET=your-32-char-minimum-session-cookie-secret

# PostgreSQL Direct Connection URLs (Optional, used for migrations / direct DB tools)
POSTGRES_URL=postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
